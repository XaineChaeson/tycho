    "@testing-library/user-event": "14.6.8",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.4",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "qrcode": "1.5.4",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
