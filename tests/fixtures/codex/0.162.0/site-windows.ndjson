@/.-]+)/gm)].map((match) => match[1]!);\r\n}\r\n\r\n// The tool names dsh's own packages register: fs (read/write/edit/apply_patch/read_image),\r\n// fs-search (glob/grep), pwsh (pwsh, and shell/terminal on other profiles), web\r\n// (web_search/web_fetch). Recorded: write and read, nothing else yet.\r\nconst CATEGORIES: Record<string, ToolCategory> = {\r\n  read: 'read',\r\n  read_image: 'read',\r\n  write: 'edit',\r\n  edit: 'edit',\r\n  apply_patch: 'edit',\r\n  glob: 'search',\r\n  grep: 'search',\r\n  web_search: 'search',\r\n  web_fetch: 'search',\r\n  pwsh: 'run',\r\n  shell: 'run',\r\n  bash: 'run',\r\n  terminal: 'run',\r\n};\r\n\r\n// The codes dsh's own errors carry: a request that comes back non-2xx fails with AUTH\r\n// (401/403) or QUOTA, and the transport's table adds RATE_LIMIT/TIMEOUT/TRANSPORT and the\r\n// rest; an account failure adds ACCOUNT_*; a credential that is absent or malformed fails\r\n// with MISSING_CREDENTIAL or INVALID_CREDENTIAL. Only MISSING_CREDENTIAL is recorded\r\n// (missing-credential.ndjson); the others are read from dsh's own sources. A rate limit,\r\n// a timeout and an interrupted task are deliberately neither: the account still works.\r\nconst AUTH_CODES = new Set([\r\n  'MISSING_CREDENTIAL',\r\n  'INVALID_CREDENTIAL',\r\n  'AUTH',\r\n  'ACCOUNT_SIGN_IN_REQUIRED',\r\n  'ACCOUNT_TOKEN_INVALID',\r\n  'ACCOUNT_SIGNED_OUT',\r\n]);\r\nconst QUOTA_CODES = new Set(['QUOTA', 'ACCOUNT_QUOTA']);\r\n\r\n// dsh's TurnEndReasonMap: a turn ends as `completed`, as `error` carrying the failure, or\r\n// as one of these, which the process turns into a non-zero exit. Only `aborted` says why\r\n// it was cancelled.\r\nconst ENDED_AS: Record<string, string> = {\r\n  aborted: '这一轮被取消',\r\n  blocked: '这一轮被挡住',\r\n  'max-tokens': '这一轮用完了 token 上限',\r\n  interrupted: '这一轮被中断',\r\n  forked: '这一轮分叉了',\r\n};\r\nconst CANCEL_CAUSE: Record<string, string> = {\r\n  user: '有人取消',\r\n  parent: '上一级取�?,\r\n  disposed: '进程退�?,\r\n  legacy: '原因没有记下',\r\n};\r\n\r\nfunction object(value: unknown): Json | undefined {\r\n  return value !== null && typeof value === 'object' && !Array.isArray(value) ? (value as Json) : undefined;\r\n}\r\n\r\nfunction lineOf(text: string): Json | undefined {\r\n  try {\r\n    return object(JSON.parse(text));\r\n  } catch {\r\n    return undefined;\r\n  }\r\n}\r\n\r\n// The code decides when it is one dsh named; the wording only catches provider errors that\r\n// arrive without one.\r\nfunction classify(code: unknown, message: string): ReadingError['kind'] {\r\n  if (typeof code === 'string') {\r\n    if (QUOTA_CODES.has(code)) return 'quota';\r\n    if (AUTH_CODES.has(code)) return 'auth';\r\n  }\r\n  if (/\\bquota\\b|insufficient[\\s_-]+(?:quota|balance|credits?)|out of[\\s_-]+(?:credits?|budget)/i.test(message)) return 'quota';\r\n  if (/\\b40[13]\\b|no api key|not logged in|not authenticated|invalid api key|unauthorized|forbidden/i.test(message)) return 'auth';\r\n  return 'other';\r\n}\r\n\r\n// What a turn that did not complete, and did not fail with an error of its own, says for\r\n// itself. `forked` and `aborted` are not failures of the account, but they are all a Run\r\n// gets to explain why the round is over.\r\nfunction endingOf(reason: Json): string {\r\n  const kind = String(reason.kind);\r\n  const said = ENDED_AS[kind] ?? `这一轮以 ${kind} 结束`;\r\n  const cause = object(reason.reason);\r\n  const cancelled = typeof cause?.kind === 'string' ? cause.kind : undefined;\r\n  if (cancelled === undefined) return said;\r\n  const why = cancelled === 'hook'\r\n    ? `钩子说：${typeof cause?.reason === 'string' ? cause.reason : '没说原因'}`\r\n    : CANCEL_CAUSE[cancelled] ?? cancelled;\r\n  return `${said}�?{why}）`;\r\n}\r\n\r\n// The failure a turn ended with, or nothing when it completed. `fallback` is what to say\r\n// when dsh's own record carries no message; its code alone still says something.\r\nfunction failureOf(reason: Json | undefined, fallback = ''): ReadingError | undefined {\r\n  if (!reason || typeof reason.kind !== 'string' || reason.kind === 'completed') return undefined;\r\n  if (reason.kind !== 'error') return { kind: 'other', message: endingOf(reason) };\r\n  const error = object(reason.error);\r\n  const code = error?.code;\r\n  const said = typeof error?.message === 'string' ? error.message : '';\r\n  const message = said || fallback || (typeof code === 'string' ? code : '这一轮出�?);\r\n  return { kind: classify(code, message), message };\r\n}\r\n\r\nfunction failure(message: string): ReadingError {\r\n  return { kind: classify(undefined, message), message };\r\n}\r\n\r\n// One step reports what it spent; a turn is the sum of its steps.\r\nfunction usageOf(value: unknown): Usage | undefined {\r\n  const usage = object(value);\r\n  if (!usage) return undefined;\r\n  const number = (key: string): number => (typeof usage[key] === 'number' ? (usage[key] as number) : 0);\r\n  return {\r\n    inputTokens: number('inputTokens'),\r\n    outputTokens: number('outputTokens'),\r\n    cacheReadTokens: number('cacheReadTokens'),\r\n    cacheWriteTokens: number('cacheWriteTokens'),\r\n  };\r\n}\r\n\r\nfunction addUsage(total: Usage | undefined, next: Usage): Usage {\r\n  if (!total) return next;\r\n  return {\r\n    inputTokens: total.inputTokens + next.inputTokens,\r\n    outputTokens: total.outputTokens + next.outputTokens,\r\n    cacheReadTokens: total.cacheReadTokens + next.cacheReadTokens,\r\n    cacheWriteTokens: total.cacheWriteTokens + next.cacheWriteTokens,\r\n  };\r\n}\r\n\r\nfunction statusEvents(line: Json): NormalizedEvent[] {\r\n  if (line.phase === 'step_end') {\r\n    const usage = usageOf(line.usage);\r\n    return usage ? [{ kind: 'usage', usage }] : [];\r\n  }\r\n  if (line.phase !== 'turn_end') return [];\r\n  const error = failureOf(object(line.reason));\r\n  return [...(error ? [{ kind: 'error' as const, error }] : []), { kind: 'turn.end' as const }];\r\n}\r\n\r\n// `--patch` takes a file and nothing else, so the tier's text reaches the round as the\r\n// snapshot's own copy; a `ref` is the machine's file, as accounts were written before\r\n// content could travel. Both are read from the Worker's working directory, which start.sh\r\n// makes the task directory.\r\nfunction overlayOf(turn: Turn): string {\r\n  if (turn.tier.kind === 'ref') return turn.tier.value;\r\n  if (!turn.tierPath) throw new Error('档位内容的快照路径没有给�?);\r\n  return turn.tierPath;\r\n}\r\n\r\n// A patch file holds a list, one entry per overlay: a mapping or a scalar at the top level\r\n// is not one, and dsh reads only what it can. What the entries say is dsh's own to check �?// it refuses a patch it cannot read with a non-zero exit rather than going on �?so nothing\r\n// of theirs is read here. A `ref` is a path on the machine, and a file that is not there\r\n// is a hard error dsh reports itself.\r\nfunction checkTier(tier: Tier): string | undefined {\r\n  if (tier.kind === 'ref') return undefined;\r\n  const why = checkTierText(tier.text);\r\n  if (why) return why;\r\n  if (tier.text.includes('\\0')) return '内容里有 tycho 传不过去的字�?;\r\n  // A document marker and a comment say nothing about the shape; blank lines are spacing.\r\n  const [first] = tier.text\r\n    .split('\\n')\r\n    .map((line) => line.trim())\r\n    .filter((line) => line !== '' && line !== '---' && !line.startsWith('#'));\r\n  if (first === undefined) return '内容不能为空';\r\n  if (!first.startsWith('-')) return '内容应是一�?YAML 列表，每�?patch 以�? 」开�?;\r\n  const governing = [...new Set(patchIds(tier.text).filter((id) => PERMISSION_KEYS.includes(id)))];\r\n  return governing.length > 0 ? permissionKeyText(governing) : undefined;\r\n}\r\n\r\nconst unquote = (value: string): string => value.replace(/\\s+#.*$/, '').trim().replace(/^(['\"])(.*)\\1$/, '$2');\r\n\r\nconst said = (value: string | undefined): string => (value === undefined ? '' : unquote(value));\r\n\r\n// A value written as a list: `[a, b]`, or the same separated by commas. One bare word is a\r\n// list of one; nothing at all is an empty list.\r\nfunction listOf(value: string | undefined): string[] {\r\n  if (value === undefined) return [];\r\n  const inside = value.trim().replace(/^\\[/, '').replace(/\\].*$/, '');\r\n  return inside.split(',').map(unquote).filter((each) => each !== '');\r\n}\r\n\r\n// One item of a `models:` block: the name written on the item's own line, and the fields\r\n// written under it.\r\ninterface DumpItem {\r\n  scalar: string;\r\n  fields: Map<string, string>;\r\n}\r\n\r\n// The items under a `models:` key: each begins with `- ` at one depth, and the fields under\r\n// it belong to it until the next item or the end of the block.\r\nfunction itemsUnder(lines: readonly string[], at: number, indent: number): DumpItem[] {\r\n  const items: DumpItem[] = [];\r\n  let depth: number | undefined;\r\n  for (let line = at + 1; line < lines.length; line += 1) {\r\n    const text = lines[line]!;\r\n    if (text.trim() === '' || text.trim().startsWith('#')) continue;\r\n    const own = /^\\s*/.exec(text)![0].length;\r\n    if (own <= indent) break;\r\n    const item = /^\\s*-\\s*(.*)$/.exec(text);\r\n    if (item && (depth === undefined || own === depth)) {\r\n      depth = own;\r\n      const held: DumpItem = { scalar: '', fields: new Map() };\r\n      const pair = /^([\\w.-]+):\\s*(.*)$/.exec(item[1]!);\r\n      if (pair) held.fields.set(pair[1]!, pair[2]!);\r\n      else held.scalar = item[1]!;\r\n      items.push(held);\r\n      continue;\r\n    }\r\n    if (depth === undefined || own <= depth) break;\r\n    const pair = /^([\\w.-]+):\\s*(.*)$/.exec(text.trim());\r\n    if (pair && items.length > 0) items[items.length - 1]!.fields.set(pair[1]!, pair[2]!);\r\n  }\r\n  return items;\r\n}\r\n\r\nfunction modelOfItem({ scalar, fields }: DumpItem): ModelInfo | undefined {\r\n  const id = unquote(scalar) || said(fields.get('id')) || said(fields.get('slug')) || said(fields.get('name'));\r\n  if (id === '') return undefined;\r\n  const name = said(fields.get('display_name')) || said(fields.get('name'));\r\n  const efforts = listOf(fields.get('efforts') ?? fields.get('reasoningEfforts'));\r\n  const fallback = said(fields.get('defaultEffort')) || said(fields.get('default_reasoning_level'));\r\n  const hidden = said(fields.get('visibility')) === 'hide' || said(fields.get('hidden')) === 'true';\r\n  return {\r\n    id,\r\n    ...(name === '' || name === id ? {} : { name }),\r\n    ...(efforts.length === 0 ? {} : { efforts }),\r\n    ...(fallback === '' ? {} : { defaultEffort: fallback }),\r\n    ...(hidden ? { hidden: true } : {}),\r\n  };\r\n}\r\n\r\n// The models a dump writes down itself. dsh's configuration is a list of patches and each\r\n// may carry a `config:` block; a route that names its models writes them under a `models:`\r\n// key, as a list on the line itself or as a block of items under it. What a route does not\r\n// write down is not guessed at: the list comes back empty and the owner fills it in.\r\n//\r\n// The exact spelling of those fields is a guess �?no `dsh --dump-config` has been recorded\r\n// on the machines this was written on �?so only the names above are read, and anything\r\n// else in the item is left where it is. A route that has to be asked for its models at its\r\n// own endpoint (the ones whose gateway serves `/models`) is where an `http` query belongs:\r\n// built here from that route's own configuration, with that route's own credentials.\r\n// Nothing here knows any gateway by name.\r\nfunction modelsInDump(text: string): ModelInfo[] {\r\n  const lines = text.split('\\n');\r\n  const found: ModelInfo[] = [];\r\n  lines.forEach((line, at) => {\r\n    const key = /^(\\s*)(?:-\\s+)?models:\\s*(.*?)\\s*$/.exec(line);\r\n    if (!key) return;\r\n    const value = key[2]!;\r\n    if (value.startsWith('[') || value === '' || value.startsWith('#')) {\r\n      const items = value.startsWith('[') ? [] : itemsUnder(lines, at, key[1]!.length);\r\n      for (const id of listOf(value)) found.push({ id });\r\n      for (const item of items) {\r\n        const model = modelOfItem(item);\r\n        if (model) found.push(model);\r\n      }\r\n    }\r\n  });\r\n  return found;\r\n}\r\n\r\nfunction command(turn: Turn, extra: string[] = []): Launch {\r\n  return {\r\n    argv: [\r\n      'dsh',\r\n      '--profile',\r\n      'headless',\r\n      '--patch',\r\n      overlayOf(turn),\r\n      '--json',\r\n      ...extra,\r\n      '--permission-mode',\r\n      turn.permissionMode ?? WORKER_MODE,\r\n      '--approval-policy',\r\n      'never',\r\n      turn.prompt,\r\n    ],\r\n    // The harness home: the profile it booted, its patches and the session log. Where the\r\n    // login lives depends on them �?the one-shot headless profile disables the credentials\r\n    // store, and then the key comes from the launching environment, $cwd/.env or\r\n    // $DSH_HOME/.env, while a patch that leaves the store on keeps it in this directory.\r\n    env: turn.configDir ? { DSH_HOME: turn.configDir } : {},\r\n  };\r\n}\r\n\r\nexport const dshAdapter: Adapter = {\r\n  // guess: no `dsh --version` has been recorded on the machines this was written on, and\r\n  // dsh's command name is the only thing known for certain. A machine that runs it reports\r\n  // what the command answers, or that it could not be run.\r\n  probe: { command: 'dsh', version: ['--version'] },\r\n  // No `loginStatus`: dsh has no command that answers \"signed in?\" �?the credential is the\r\n  // launching environment's, and its absence shows up as a failure of the turn instead.\r\n  // Recorded (resume.ndjson): `--session-id` adopts the session the previous round left,\r\n  // and the one-shot runner accepts it in the same working directory.\r\n  resumable: true,\r\n  permissionModes: PERMISSION_MODES,\r\n  // No `readOnly`: a tier can replace or insert any plugin, so no read-only way of dsh's holds (see\r\n  // PERMISSION_KEYS). Its lowest version still holds for every Worker.\r\n  minVersion: MIN_VERSION,\r\n  permissionKeys: PERMISSION_KEYS,\r\n  // A tier is a patch list; the form edits the `agent-default-model` entry's provider,\r\n  // model and reasoning effort, and leaves every other entry and setting as it was.\r\n  tierForm: { ...PATCH_LIST, fields: ['provider', 'model', 'effort'], efforts: TIER_EFFORTS },\r\n  checkTier,\r\n  // What the configuration itself writes down, read from a dump. dsh has no catalog of its\r\n  // own to print: which models a route serves is that route's business.\r\n  listModels: () => ({ kind: 'command', argv: ['dsh', '--dump-config'], parse: modelsInDump }),\r\n  launch: (turn) => command(turn),\r\n\r\n  resume(turn) {\r\n    if (!turn.sessionRef) throw new Error('续接需�?session_ref');\r\n    return command(turn, ['--session-id', turn.sessionRef]);\r\n  },\r\n\r\n  parse(text) {\r\n    const line = lineOf(text);\r\n    if (!line) return [];\r\n    switch (line.type) {\r\n      case 'text':\r\n        return typeof line.text === 'string' ? [{ kind: 'text', text: line.text }] : [];\r\n      case 'thinking':\r\n        return typeof line.text === 'string' ? [{ kind: 'thinking', text: line.text }] : [];\r\n      case 'tool_call':\r\n        if (typeof line.callId !== 'string' || typeof line.tool !== 'string') return [];\r\n        return [{ kind: 'tool.start', id: line.callId, category: CATEGORIES[line.tool] ?? 'other', name: line.tool }];\r\n      case 'tool_result':\r\n        if (typeof line.callId !== 'string') return [];\r\n        return [{ kind: 'tool.end', id: line.callId, isError: line.status === 'error' }];\r\n      case 'status':\r\n        return statusEvents(line);\r\n      // `fail()` writes this line and exits 1, and on a usage error it is the only place\r\n      // the reason appears: the headless app replaces commander's own error output.\r\n      // Recorded: usage-error.ndjson.\r\n      case 'error':\r\n        return typeof line.message === 'string' ? [{ kind: 'error', error: failure(line.message) }] : [];\r\n      // `session` and `final` add nothing to the stream: the session reference and the\r\n      // turn's text are read from the result, and turn_end already said the turn ended.\r\n      default:\r\n        return [];\r\n    }\r\n  },\r\n\r\n  result(stdout, exitCode, stderr) {\r\n    let sessionRef: string | undefined;\r\n    let usage: Usage | undefined;\r\n    let last: Json | undefined;\r\n    // What a run that never ended a turn said for itself, before it exited.\r\n    let said: string | undefined;\r\n    for (const text of stdout.split('\\n')) {\r\n      const line = lineOf(text);\r\n      if (!line) continue;\r\n      // The session line comes first, and an interrupted run has only it and the statuses.\r\n      if (typeof line.sessionId === 'string') sessionRef ??= line.sessionId;\r\n      if (line.type === 'status' && line.phase === 'step_end') {\r\n        const step = usageOf(line.usage);\r\n        if (step) usage = addUsage(usage, step);\r\n      }\r\n      if (line.type === 'error' && typeof line.message === 'string') said = line.message;\r\n      if (line.type === 'final') last = line;\r\n    }\r\n    const text = typeof last?.text === 'string' ? last.text : undefined;\r\n    const reading: Reading = {\r\n      ...(text === undefined ? {} : { text }),\r\n      ...(sessionRef === undefined ? {} : { sessionRef }),\r\n      ...(usage === undefined ? {} : { usage }),\r\n      finished: last !== undefined,\r\n    };\r\n    const stderrTail = stderr.trim().slice(-STDERR_TAIL);\r\n    // What the Runner saw, for a failure dsh's own record does not explain.\r\n    const observed = said || stderrTail || (exitCode === null ? '' : `进程退出码 ${exitCode}`);\r\n\r\n    if (!last) {\r\n      // No final line: the turn never ended. A Worker the Runner stopped is passed no exit\r\n      // code; that is not a failure of the executor.\r\n      return exitCode === null ? reading : { ...reading, error: failure(observed) };\r\n    }\r\n\r\n    const error = failureOf(object(last.reason), observed);\r\n    if (error) return { ...reading, error };\r\n    if (exitCode !== null && exitCode !== 0) return { ...reading, error: failure(observed) };\r\n    return reading;\r\n  },\r\n};\r\nFILE: tier.ts\r\nimport { valueLines } from '../shared/tier-form.ts';\r\n\r\n// One tier's value. `content` is the executor's own configuration text, which rides the\r\n// snapshot to the machine; `ref` is a place on the machine that already holds it, which is\r\n// what an account held before the text could travel with the Run.\r\nexport type Tier = { kind: 'content'; text: string } | { kind: 'ref'; value: string };\r\n\r\n// A tier's text becomes one file in a snapshot and, for Codex, one argument of one command\r\n// line per line: room for any settings file, short of what a shell or an argument list\r\n// takes badly.\r\nexport const MAX_TIER_CHARS = 20_000;\r\n\r\n// The checks that hold for every executor's own text, whichever one it is: a tier empty\r\n// enough to say nothing, and a text too long for the file or the argument list it becomes.\r\n// What the executor makes of the text is the adapter's own declaration.\r\nexport function checkTierText(text: string): string | undefined {\r\n  if (text.trim() === '') return '内容不能为空';\r\n  if (text.length > MAX_TIER_CHARS) return `内容太长（最�?${MAX_TIER_CHARS} 个字）`;\r\n  return undefined;\r\n}\r\n\r\n// What a tier that carries a permission, sandbox or approval setting is told (§5): permission\r\n// is the role's, and the service writes it onto the command line itself. Said, never stripped.\r\nexport const permissionKeyText = (keys: readonly string[]): string =>\r\n  `档位内容里不能写管权限、沙箱、审批的设置�?{keys.join('�?)}）：权限由职能决定，服务按职能改写启动参数。把这几项删掉再存`;\r\n\r\n// The lines of a Codex tier, as the CLI is handed them, with the line they were written\r\n// on: a carriage return is the console's line ending, not part of a value. Blank lines\r\n// carry nothing and are left out, so a text file's trailing newline is not a mistake. The\r\n// console reads the same lines through the same rule, in `shared/tier-form.ts`.\r\nexport function codexLines(text: string): { at: number; line: string }[] {\r\n  return valueLines(text);\r\n}\r\n\r\n// The `�?值` pairs of a Codex tier, in the words it was written in: the value is the\r\n// CLI's own (TOML, or the literal it falls back to) and is never reassembled here. The\r\n// validator below reads the same lines, so what it lets through is what runs.\r\nexport function codexSettings(text: string): { key: string; value: string }[] {\r\n  return codexLines(text).flatMap(({ line }) => {\r\n    const equal = line.indexOf('=');\r\n    return equal <= 0 || line.slice(0, equal).trim() === '' ? [] : [{ key: line.slice(0, equal), value: line.slice(equal + 1) }];\r\n  });\r\n}\r\n\r\n// Whether a tier's value is one an executor could be given at all: an account saved with\r\n// an empty value is no candidate for a Task that names that tier.\r\nexport function hasTierValue(value: Tier | undefined): boolean {\r\n  if (!value) return false;\r\n  return value.kind === 'ref' ? value.value !== '' : value.text.trim() !== '';\r\n}\r\nFILE: types.ts\r\nimport type { Tier } from './tier.ts';\r\nimport type { TierForm } from '../shared/tier-form.ts';\r\nimport type { ReadOnlyLayer } from '../shared/roles.ts';\r\n\r\nexport type { Tier };\r\n\r\nexport interface Turn {\r\n  prompt: string;\r\n  workdir: string;\r\n  // The tier as the ledger held it: content is the executor's own configuration text,\r\n  // `ref` a place on the machine that has it.\r\n  tier: Tier;\r\n  // For content, where the snapshot keeps it, relative to the Worker's working directory\r\n  // (`runs/<run>/snapshot/tier.json`). Absent for `ref`, which is not in the snapshot,\r\n  // and for an executor that takes its content on the command line.\r\n  tierPath?: string;\r\n  // Absent means the login the machine already has: the executor's variable is not set.\r\n  configDir?: string;\r\n  // What the account named, out of the adapter's permissionModes. Absent means the mode\r\n  // the adapter runs a Worker under.\r\n  permissionMode?: string;\r\n  // A round of a read-only role: the adapter starts it its declared read-only way, whatever\r\n  // `permissionMode` says �?an account's mode may make it tighter, never looser.\r\n  readOnly?: boolean;\r\n  sessionRef?: string;\r\n}\r\n\r\n// How this executor runs a round read-only (docs/design/roles-and-tiers.md §5), measured in\r\n// docs/spike/readonly.md. `args` are what its command carries for it; `layer` is how far they\r\n// reach. Whether the way works is a fact of each machine, which its client finds out with\r\n// `probe`: a command that writes nothing and spends no quota, run in that machine's login\r\n// shell. Exit code 0 and nothing said by `check` is \"available\"; anything else �?a failure, a\r\n// timeout, a check that finds the switch missing �?is not, with the words it gave.\r\nexport interface ReadOnlyWay {\r\n  layer: ReadOnlyLayer;\r\n  args: readonly string[];\r\n  // Why a round on this tier value cannot be made read-only this way, or nothing when it can:\r\n  // a value that may carry settings the way cannot hold against. Absent: any value will do.\r\n  tierProblem?: (tier: Tier) => string | undefined;\r\n  probe: { argv: string[]; check?: (stdout: string, stderr: string) => string | undefined };\r\n}\r\n\r\n// The lowest version of the executor's own command that takes what this program's commands\r\n// pass it, and what an older one lacks, in the owner's words.\r\nexport interface MinVersion {\r\n  version: string;\r\n  lacks: string;\r\n}\r\n\r\n// Where a `ref` tier's file is on the machine: `dir` is a shell expression, run as it is\r\n// so that what the account set (`CODEX_HOME`, the login's home) is honoured, and `name`\r\n// is the file inside it.\r\nexport interface RefTierFile {\r\n  dir: string;\r\n  name: string;\r\n}\r\n\r\nexport interface Launch {\r\n  argv: string[];\r\n  env: Record<string, string>;\r\n}\r\n\r\nexport type ToolCategory = 'read' | 'edit' | 'run' | 'search' | 'other';\r\n\r\nexport interface Usage {\r\n  inputTokens: number;\r\n  outputTokens: number;\r\n  cacheReadTokens: number;\r\n  cacheWriteTokens: number;\r\n  costUsd?: number;\r\n}\r\n\r\nexport interface ReadingError {\r\n  kind: 'quota' | 'auth' | 'other';\r\n  message: string;\r\n  // With 'quota', when the executor's own output says the quota comes back. Never read\r\n  // out of the message: that is a sentence for people, in the account's time zone.\r\n  resetsAt?: string;\r\n}\r\n\r\nexport type NormalizedEvent =\r\n  | { kind: 'text'; text: string }\r\n  | { kind: 'thinking'; text: string }\r\n  | { kind: 'tool.start'; id: string; category: ToolCategory; name: string }\r\n  | { kind: 'tool.end'; id: string; isError: boolean }\r\n  | { kind: 'turn.end' }\r\n  | { kind: 'interrupted' }\r\n  | { kind: 'error'; error: ReadingError }\r\n  // Shown as \"blocked, retrying\"; the turn is still alive.\r\n  | { kind: 'retry'; attempt: number; maxRetries: number; delayMs: number; error: string }\r\n  | { kind: 'usage'; usage: Usage }\r\n  // How much of one of the account's quota windows is used, 0 to 1, and when that window\r\n  // starts over. Only from an executor that reports it while it runs. It is about the\r\n  // target, not the Run: the Runner keeps it out of the Run's log.\r\n  | { kind: 'quota'; window: string; used: number; resetsAt: string | null }\r\n  // Never from an adapter: the Runner's mark for what its bounded log has dropped.\r\n  | { kind: 'truncated'; dropped: number };\r\n\r\nexport interface Reading {\r\n  text?: string;\r\n  sessionRef?: string;\r\n  usage?: Usage;\r\n  error?: ReadingError;\r\n  finished: boolean;\r\n}\r\n\r\n// One model an executor reports for an account: `id` is what a tier names it by, `name`\r\n// what the executor shows it as. `efforts` are the strengths this model takes, in its own\r\n// order, and `defaultEffort` the one the executor uses when a tier names none. `hidden`\r\n// is a model the executor keeps out of its own picker; it is reported all the same, and\r\n// what to do with it is the console's. Absent `efforts` means the executor says nothing\r\n// about that model's strengths, not that it takes none.\r\nexport interface ModelInfo {\r\n  id: string;\r\n  name?: string;\r\n  efforts?: string[];\r\n  defaultEffort?: string;\r\n  hidden?: boolean;\r\n}\r\n\r\n// How this executor answers \"which models can this account use\": one question, and how to\r\n// read its answer. The adapter declares both and asks neither �?the service asks over the\r\n// network with the account's token, or runs the command on a machine the account may use.\r\n// Either way an answer that cannot be read comes back as no models, never as a guess.\r\nexport type ModelQuery =\r\n  // A request the caller makes itself. The token is in `headers` and belongs nowhere else.\r\n  | { kind: 'http'; url: string; headers: Record<string, string>; parse(body: string): ModelInfo[] }\r\n  // A command the caller runs on a machine, as the account's own login would run it.\r\n  | { kind: 'command'; argv: string[]; parse(stdout: string): ModelInfo[] };\r\n\r\nexport interface Adapter {\r\n  credentialFd?: string;\r\n  // Declared by the executor that can drive the Router itself: it has to run with no\r\n  // built-in tools and answer each turn, which not every CLI here does.\r\n  canRoute?: true;\r\n  // How this executor's own command is asked what it is, on a machine that may run it: the\r\n  // command itself, and the arguments that make it print its version. Declared because the\r\n  // command name and its own switch are the executor's facts, not the caller's. Absent when\r\n  // there is no such command, and then a machine reports nothing about this executor\r\n  // (docs/design/nodes.md §1.2, §11 step 5).\r\n  probe?: { command: string; version: string[] };\r\n  // The arguments that make the executor's own command say whether it is signed in, by\r\n  // its exit code: 0 when it is. Absent when the executor has no such command.\r\n  loginStatus?: string[];\r\n  // Whether a later Run of the same Task, on the same account and machine, may adopt the\r\n  // session this one leaves. Absent means it may not: the next round starts a new session.\r\n  resumable?: boolean;\r\n  // What this executor's own command takes for the permission mode, as the values an\r\n  // account may name. Absent when it takes none, and then an account must not name one.\r\n  permissionModes?: readonly string[];\r\n  // How a round of this executor is made read-only. Absent when it has no way that holds,\r\n  // and then no read-only role is ever dispatched to it.\r\n  readOnly?: ReadOnlyWay;\r\n  // Absent when any version of its command will do.\r\n  minVersion?: MinVersion;\r\n  // The keys of a tier's text that govern permissions, sandbox or approval: a tier carrying\r\n  // one is refused by `checkTier`, on save and again before a Run (§5) �?permission is the\r\n  // role's, and the service writes it onto the command line.\r\n  permissionKeys?: readonly string[];\r\n  // How a tier of this executor is written and read: which shape its text takes, which\r\n  // values the console's form edits, and the strengths its own command takes. Absent when\r\n  // the console may only show the text as it is.\r\n  tierForm?: TierForm;\r\n  // Whether this executor could be handed a tier's value at all: the whole of what can be\r\n  // told without asking the CLI, which drops or replaces a tier it cannot read without a\r\n  // word. A `ref` is a place on the machine, except where the executor's own command reads\r\n  // a value of that shape as the tier's text. Absent when any value will do.\r\n  checkTier?: (tier: Tier) => string | undefined;\r\n  // How to ask which models an account of this executor may use, given the account's login\r\n  // token when it has one. Absent when there is no way to ask, and then the account's list\r\n  // stays empty and the console's form takes a model typed by hand.\r\n  listModels?: (context: { token?: string }) => ModelQuery;\r\n  // For an executor that reads a `ref` tier's missing file as \"use your own\r\n  // configuration\" and says nothing: where that file is, so the Runner can ask a machine\r\n  // whether it is there. Absent when a missing file is an error the executor reports.\r\n  refTierFile?: (value: string) => RefTierFile;\r\n  launch(turn: Turn): Launch;\r\n  resume(turn: Turn): Launch;\r\n  // For display only: a line it cannot read yields nothing and never changes a Run.\r\n  parse(line: string): NormalizedEvent[];\r\n  result(stdout: string, exitCode: number | null, stderr: string): Reading;\r\n}\r\n\r\n// What the service reads out of the adapters by executor name instead of asking about any\r\n// executor itself: the dispatcher whether a session may be continued, the account check\r\n// which permission modes an account may name and which tier values its command can be\r\n// given, the model catalog how an account's models are asked for, and the console how a\r\n// tier of it is written. The adapters themselves are the authority.\r\nexport type ExecutorDeclarations = Pick<Adapter, 'resumable' | 'permissionModes' | 'checkTier' | 'tierForm' | 'listModels' | 'readOnly' | 'minVersion'>;\r\nexport type Executors = Readonly<Record<string, ExecutorDeclarations>>;\r\nFILE: version.ts\r\nimport type { MinVersion } from './types.ts';\r\n\r\n// The first `x.y.z`, with its pre-release part, in a CLI's version line: `0.2.2-rc.1`,\r\n// `codex-cli 0.163.0`, `2.1.312 (Claude Code)`.\r\nconst VERSION = /(\\d+)\\.(\\d+)\\.(\\d+)(?:-([0-9A-Za-z.-]+))?/;\r\n\r\nexport function versionOf(line: string): string | undefined {\r\n  return VERSION.exec(line)?.[0];\r\n}\r\n\r\n// Semantic-version order: the numbers, then a pre-release below its release, its parts\r\n// compared as numbers where both are numbers.\r\nexport function compareVersions(a: string, b: string): number {\r\n  const [, ...left] = VERSION.exec(a) ?? [];\r\n  const [, ...right] = VERSION.exec(b) ?? [];\r\n  for (let at = 0; at < 3; at += 1) {\r\n    const diff = Number(left[at] ?? 0) - Number(right[at] ?? 0);\r\n    if (diff !== 0) return Math.sign(diff);\r\n  }\r\n  const [preA, preB] = [left[3], right[3]];\r\n  if (preA === undefined || preB === undefined) return preA === preB ? 0 : preA === undefined ? 1 : -1;\r\n  const partsA = preA.split('.');\r\n  const partsB = preB.split('.');\r\n  for (let at = 0; at < Math.max(partsA.length, partsB.length); at += 1) {\r\n    const [x, y] = [partsA[at], partsB[at]];\r\n    if (x === undefined || y === undefined) return x === undefined ? -1 : 1;\r\n    const numeric = /^\\d+$/.test(x) && /^\\d+$/.test(y);\r\n    const diff = numeric ? Number(x) - Number(y) : x < y ? -1 : x > y ? 1 : 0;\r\n    if (diff !== 0) return Math.sign(diff);\r\n  }\r\n  return 0;\r\n}\r\n\r\n// Why the version a machine's command printed cannot run this program's commands, or nothing\r\n// when it can �?or when no version can be read out of the line: that decides nothing, and the\r\n// read-only probe still asks the command itself.\r\nexport function tooOld(min: MinVersion, line: string): string | undefined {\r\n  const version = versionOf(line);\r\n  if (version === undefined || compareVersions(version, min.version) >= 0) return undefined;\r\n  return `这一版用不了�?{min.lacks}，升�?${min.version} 以上`;\r\n}\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"\"C:\\\\WINDOWS\\\\System32\\\\WindowsPowerShell\\\\v1.0\\\\powershell.exe\" -Command \"Get-Content -LiteralPath 'docs/design/phase1-design.md' -TotalCount 100; Get-Content -LiteralPath 'docs/design/merged-design.md' -TotalCount 100; git -c core.excludesFile=NUL --no-optional-locks status --porcelain=v1 --untracked-files=all; git --no-optional-locks diff --stat; git --no-optional-locks diff --cached --stat\"","aggregated_output":"# 第一阶段详细设计：状态和对话\r\n\r\n状态：v4 定稿�?026-11-04 用户确认；后续只按实测结果修订。三�?Codex 对抗审阅后的精简版（[第一轮](codex-phase1-review.md)、[第二轮](codex-phase1-review-2.md)、[第三轮：奥卡姆剃刀](codex-phase1-review-3.md)）。上位文档是 [merged-design.md](merged-design.md)；冲突处以本文为准并回写上位文档�?\r\n**第一阶段交付的是：一个跑在工作站上的编排服务，账本持久、总控逻辑常驻、企业微信和网页两个入口、能向集群实例派�?Claude �?Codex�?* 合入仍走现有流程�?\r\n承诺：任何时刻崩溃，重启后账本、进程和外部现场三者的关系要么被核实，要么被标为“未知”并如实显示；旧执行被判定不在之前，不启动新的执行。不承诺恰好一次�?\r\n预期内的事由规则处理，不找你�?026-11-05 修订）：干活的机器被销毁、失联是预期内的事，�?§4 的规则判定旧执行已不在，自动接续，只在时间线上留记录；账号的额度用完也是，按 §4“额度用完之后”的规则让账号歇着、任务换账号或等着；接续的一轮先核对现场。只有规则处理不了的才找你：同一任务连续丢失到上限、一个账号没有任何可用的机器�?\r\n信任边界：集群实例的用户身份�?Worker 的信任边界，Worker 之间没有 OS 隔离；每任务独立目录只是 Git 和整洁上的隔离�?\r\nv4 相对 v3 的取舍原则：前两轮把很多“必须如实报告的不确定性”变成了“必须自动解决的不确定性”，v4 把它们改回报告。删掉的机制和删后你会看到什么，见第三轮审阅�?\r\n## 1. 范围\r\n\r\n做：Task Ledger（SQLite）、入站消息处理、Session Host、SSH Runner、Claude �?Codex 适配器、企微长连接通道、Console、Outbox、预约、全局暂停、追溯、配置快照�?\r\n不做：依赖调度和上游自动恢复、预算（按额度自动换账号已经在第一阶段做了，见 §4“额度用完之后”）、交付自动化、飞书与外部事件入口、dsh 适配器、回合内插话、工作站上的 Worker、自动回执修复、在线接管、可编辑�?IM 消息、主机自己提�?HTTPS、Watchdog 的模型判断。这些要么属于后面阶段，要么被第三轮审阅判定为此规模下不值得�?\r\n## 2. 技术栈与部�?\r\n| �?| 选择 |\r\n|---|---|\r\n| 语言与运行时 | TypeScript，Node 24；服务端没有构建步骤。最低版本只�?`package.json` �?`engines.node` 一处声明（§2.1�?|\r\n| 主机系统 | Windows、Linux、macOS。查找和结束总控进程按平台实现（§6）；别的系统上服务照常运行，总控停摆并写明原�?|\r\n| 数据�?| `node:sqlite`，WAL，`synchronous=FULL`；消息正文、brief、技能快照都存库；原始日志存文件 |\r\n| SSH | 系统 OpenSSH 进程，`BatchMode=yes`、`ConnectTimeout`；known_hosts 由系�?OpenSSH 管理，身份错误即报告 |\r\n| 服务端运行时依赖 | 零。企微长连接用自带的 `channels/ws-client.ts`（网关按大小写匹配握手头 `Sec-WebSocket-Key`，Node 内置 WebSocket 发小写，被拒�?|\r\n| Console 前端 | `console/` 下独立的 React + TypeScript + Vite 工程，使�?shadcn/ui（Tailwind、Radix）和 TanStack Query；有自己�?`package.json` 和构建步骤。服务提�?`console/dist/`；共用的文字与纯函数只放 `shared/`，服务端�?import `console/` |\r\n| 分发与安�?| 发布包加一行安装脚本，不走 npm；程序目录和数据目录分开（�?.1�?|\r\n| 进程守护 | 开机自启，装在当前用户下、登录后启动、失败后重启：Windows 计划任务，Linux systemd 用户服务，macOS LaunchAgent（�?.1�?|\r\n| 测试 | 服务端用 `node --test`；前端用 Vitest、Testing Library，浏览器冒烟�?Playwright 和本�?Edge；适配器契约测试用录制输出，崩溃注入覆�?§11 |\r\n| 仓库 | 单仓库：`service/ console/ shared/ adapters/ runner/ channels/ cli/ install/ scripts/ tests/ docs/` |\r\n\r\n部署�?\r\n- 服务进程在主机上以当前用户运行。启动只认一个数据目录：环境变量 `TYCHO_DATA`，默�?`~/.tycho/host`，不存在就建。数据目录通过 `service/config.ts` �?`dataDirOf` 解析，默认数据目录与程序目录共同�?`service/home-paths.ts` 一个出口，命令和服务都用它；它总是给出绝对路径，相对的 `TYCHO_DATA` 按调用时的当前目录解析，因为服务管理器会在别的目录里启动服务。里面是账本 `ledger.db`、`runs/`（原始日志副本）、`secrets/`（密钥）、`degraded.log`，以及服务自己写�?`lock`、`service.json`、`login-token` �?`gateway.pid`（门牌连接的启动意图，见下）。启动不读配置文件�?  - 测试运行时先加载 `tests/guard.ts`，在子进程创建处保留身份并让 Node 辅助进程预加载相同防护；重建 env 不会丢失身份。默认目录出口记录首次测试身份并拒绝主人的默认目录，不依赖可能读不到的父进程表。尚�?Node �?bootstrap 安装脚本不能调用 TS，必须在计算默认程序目录之前按相同身份拒绝缺�?`TYCHO_PREFIX` 的测试�?- 服务有两个监听。对内监听的地址和端口是 `http.host`、`http.port`（默�?8787），启动时读一次，改后重启服务。`http.host` 只取 `127.0.0.1`（默认）�?`0.0.0.0`（同一局域网或组网直接访问；不绑具体网卡地址，因为地址可能未就绪）。页面和控制台接口靠登录 Cookie；本机程序接口另验令牌。本机代理把 EasyTier 网段加入 `NO_PROXY`。对外监听是 `gateway.localPort`（默�?8788），只绑 `127.0.0.1`，配置了门牌才监听；它提供页面、登录兑换和已登录的控制台接口，本机令牌接口在这里不可达（�?0）�?  - 端口的取值顺序：这一次运行指定的端口，否则配置项 `http.port`。只替换对内监听端口，指定的办法�?`tycho run --port <端口>`，命令经环境变量 `TYCHO_PORT` 交给服务。它只对这一次运行生效，不写进设置，所以不是第二个改配置的地方；它是默认端口被占、控制台起不来时的出路。端口被占时服务报错退出，报错里给出这条命令。`TYCHO_PORT=0` 表示这一次由系统挑一个空闲端口，`service.json` 写实际绑上的端口；这是给起服务的程序（测试）用的，`tycho run --port` 不收 0�?  - 给本机进程用的接口只接受回环对端，再各验自己的令牌，不看登录 Cookie：`/tools/*`（总控的工具令牌，§6）、`/api/login-links`（数据目录里�?`login-token`）、`/api/shutdown` �?`/api/instance`（`service.json` 里的令牌）。对内的 `GET /api/doctor` 有两种认证：请求�?`Authorization` 头时按本机接口处理，�?`service.json` 里的令牌，`tycho doctor` 用它；不带时按登�?Cookie，控制台用它；对外只保留 Cookie 认证的这一条�?- 门牌：主机自己看管一条到门牌机器�?SSH 反向转发，nginx 在门牌上提供 HTTPS，主机不开公网入站端口。门牌故障不拖垮服务�?  - 四个配置项都在“设�?�?门牌”：`gateway.ssh`（门牌机器，默认空即停用，写�?`用户名@地址` �?`用户名@地址:端口`）、`gateway.keyFile`（私钥路径，默认空即用运行服务用户自己的 SSH 配置和密钥；填了它，自检查它是不是只有运行服务的用户能读——Windows 按访问列表、其余按权限位，别人能读就列出是谁并给出 `icacls` �?`chmod` 的修法，只报告不替主人改）、`gateway.remotePort`（门牌回环端口，默认 18787）、`gateway.localPort`（主机对外入口，默认 8788）。改完先停旧连接、关闭旧监听，再按新值接通，不用重启服务。门牌地址只接受用户名、主机名�?IPv4 地址与可选端口，不接�?SSH 参数�?  - 拉起 ssh 之前，先同步持久�?`<数据目录>/gateway.pid`，内容是 `{ state: \"starting\", marker }`，不�?PID。标记由数据目录的真实路径派生，也放在命令行�?`SendEnv` 参数中。记录写不进就不启动；服务重启先按标记查找并清理残留�?  - 固定�?`ssh -N -v -R 127.0.0.1:<remotePort>:127.0.0.1:<localPort>`，带 `BatchMode=yes`、`ExitOnForwardFailure=yes`、`ServerAliveInterval=30`、`ServerAliveCountMax=3`、`StrictHostKeyChecking=accept-new`、`ConnectTimeout=15`。同时固�?`ForkAfterAuthentication=no`、`ControlMaster=no`、`ControlPath=none`、`ControlPersist=no`，保持前台、独占连接；填私钥才�?`-i` �?`IdentitiesOnly=yes`，填端口才加 `-p`�?  - 只在 ssh 明确报告远端转发建立后显示“已连接”；退出后�?1 秒退避到 60 秒重连，保留最近错误。对外端口被占也显示门牌故障，服务和对内控制台照常�?  - 停止、重配和启动后异常都先结束归属的整棵进程树，再按标记复查；POSIX 用独立进程组，先 SIGTERM、再 SIGKILL，Windows �?`taskkill /T /F`。确认没有残留后才删归属记录、启动下一条。清理或删记录失败时保留记录并显�?`down` 和原因，停用也不改写�?`off`。自行脱离进程树且没有标记的自定�?`ProxyCommand` 子代不在这项核实保证内�?- 数据目录�?`<数据目录>/lock`：服务和恢复都先取它，同一个数据目录同时只有一个持有者�?  - 锁里记持有者的进程号和这个进程的启动时刻（`process_start`），以及写它的那台机器（`machine`，另记主机名 `hostname` 供人看）。启动时刻由操作系统给出，只和自己比较：Linux �?`/proc/<pid>/stat` 的启动时刻加 `boot_id`，macOS �?`ps`，Windows �?PowerShell�?  - 持有者活着，要两样都对上：进程号活着，现在问到的启动时刻和锁里记的相同。进程号不代表进程：容器里服务每次启动都是同一个进程号，别处进程号也会被重用，只看进程号会把崩溃留下的锁当成另一个活着的实例�?  - 机器身份是这台机器自己的名字：Linux �?`/etc/machine-id`（没有就�?`/var/lib/dbus/machine-id`），macOS �?`ioreg` �?`IOPlatformUUID`，Windows 读注册表�?`MachineGuid`，都读不到就用主机名。进程号只在本机有意义：两台机器共用一�?home（集群实例就是这样）时，第二台看不到第一台的进程，只看进程号会把对方活着的锁当成陈旧的，于是两份服务同写一个账本�?  - 锁属于另一台机器时，本机不判它死活、也不覆盖：拒绝启动，报出那台机器、那个进程号，以及确认对方已停之后删掉锁文件这条出路（`service/lock.ts` �?`elsewhereText`，