   };\r\n  },\r\n  resume() { throw new Error('Codex 第一阶段不续�?); },\r\n  parse(text) { const line = lineOf(text); return line ? events(line) : []; },\r\n  result(stdout, exitCode, stderr) {\r\n    const reading: Reading = { finished: false };\r\n    let error: ReadingError | undefined;\r\n    let turnFailed = false;\r\n    for (const text of stdout.split('\\n')) {\r\n      const line = lineOf(text);\r\n      if (!line) continue;\r\n      if (line.type === 'thread.started' && typeof line.thread_id === 'string') reading.sessionRef = line.thread_id;\r\n      if (line.type === 'turn.completed') { reading.finished = true; reading.usage = usageOf(line.usage); }\r\n      if (line.type === 'turn.failed') turnFailed = true;\r\n      for (const event of events(line)) {\r\n        if (event.kind === 'text') reading.text = event.text;\r\n        if (event.kind === 'error') error = event.error;\r\n      }\r\n    }\r\n    // Error events alone do not fail a Run: the recordings show a metadata warning\r\n    // as an item error and \"Reconnecting...\" as top-level errors, and a turn can\r\n    // still complete after either. Only a failed turn or a non-zero exit does.\r\n    if (turnFailed || (exitCode !== null && exitCode !== 0)) {\r\n      const message = error?.message || stderr.trim().slice(-2000) || `进程退出码 ${exitCode}`;\r\n      reading.error = { kind: classify(message), message };\r\n    }\r\n    return reading;\r\n  },\r\n};\r\nFILE: dsh.ts\r\nimport { checkTierText, permissionKeyText } from './tier.ts';\r\nimport type { Adapter, Launch, ModelInfo, NormalizedEvent, Reading, ReadingError, Tier, ToolCategory, Turn, Usage } from './types.ts';\r\nimport { PATCH_LIST } from '../shared/tier-form.ts';\r\n\r\ntype Json = Record<string, unknown>;\r\n\r\nconst STDERR_TAIL = 2000;\r\n\r\n// As the other two executors: the machine is the isolation boundary, so the Worker runs\r\n// without a sandbox. `--permission-mode` picks one of the presets dsh-base configures, and\r\n// the account