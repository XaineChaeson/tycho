r\n        return [];\r\n    }\r\n  },\r\n\r\n  result(stdout, exitCode, stderr) {\r\n    let last: Json | undefined;\r\n    let sessionRef: string | undefined;\r\n    let errorCode: unknown;\r\n    // When the window the CLI last named as the one in force starts over.\r\n    let resetsAt: string | null = null;\r\n    for (const text of stdout.split('\\n')) {\r\n      const line = parseLine(text);\r\n      if (!line) continue;\r\n      const limits = rateLimitInfo(line);\r\n      if (limits) resetsAt = instant(limits.resetsAt);\r\n      // An interrupted Worker has no result line, yet a resume still needs this.\r\n      if (typeof line.session_id === 'string') sessionRef ??= line.session_id;\r\n      if (line.type === 'assistant' && line.is_api_error_message) errorCode = line.error;\r\n      if (line.type === 'result') last = line;\r\n    }\r\n    const session = sessionRef === undefined ? {} : { sessionRef };\r\n    const stderrTail = stderr.trim().slice(-STDERR_TAIL);\r\n    const failure = (message: string, status: unknown, code: unknown): ReadingError => {\r\n      const kind = classify(message, status, code);\r\n      return { kind, message, ...(kind === 'quota' && resetsAt ? { resetsAt } : {}) };\r\n    };\r\n\r\n    if (!last) {\r\n      const reading: Reading = { ...session, finished: false };\r\n      if (exitCode === null) return reading;\r\n      const message = stderrTail || `进程退出码 ${exitCode}，没有结果`;\r\n      return { ...reading, error: failure(message, undefined, errorCode) };\r\n    }\r\n\r\n    const text = typeof last.result === 'string' ? last.result : undefined;\r\n    const usage = usageOf(last);\r\n    const reading: Reading = {\r\n      ...(text === undefined ? {} : { text }),\r\n      ...(typeof last.session_id === 'string' ? { sessionRef: last.session_id } : session),\r\n      ...(usage ? { usage } : {}),\r\n      finished: true,\r\n    };\r\n    // subtype stays \"success\" on failure in the recording, so it is not consulted.\r\n    const failed = last.is_error === true || (exitCode !== null && exitCode !== 0);\r\n    if (!failed) return reading;\r\n    const message = (last.is_error ? text : undefined) || stderrTail || `进程退出码 ${exitCode}`;\r\n    return { ...reading, error: failure(message, last.api_error_status, last.api_error ?? errorCode) };\r\n  },\r\n};\r\nFILE: codex.ts\r\nimport { checkTierText, codexLines, codexSettings, permissionKeyText } from './tier.ts';\r\nimport type { Adapter, ModelInfo, NormalizedEvent, Reading, ReadingError, Tier, ToolCategory, Usage } from './types.ts';\r\nimport { KEY_VALUE_LINES } from '../shared/tier-form.ts';\r\n\r\n// guess: the reasoning levels the CLI's own model catalog lists (read from `codex debug\r\n// models` on 0.162.0: low, medium, high, xhigh, max); a level outside this list is the\r\n// owner's own text and rides the tier as it stands.\r\nconst TIER_EFFORTS = ['low', 'medium', 'high', 'xhigh', 'max'];\r\n// The settings that govern Codex's sandbox and approvals, from its configuration reference:\r\n// a key whose dotted path names one of them, wherever it sits (a profile's\r\n// `profiles.<name>.sandbox_mode`, a table's `sandbox_workspace_write.network_access`).\r\nconst PERMISSION_KEYS = ['sandbox_mode', 'approval_policy', 'sandbox_workspace_write', 'sandbox_permissions'];\r\n// Measured (docs/spike/readonly.md): `--sandbox read-only` holds at the operating system's\r\n// file access �?the edit tool, the shell, what the shell starts and an MCP server's process\r\n// are all refused writing, inside the working directory and out. On a machine whose sandbox\r\n// cannot start (the cluster's Apptainer, no usable bwrap) every command fails instead: the\r\n// probe below finds that out before any round is sent there.\r\nconst READ_ONLY_ARGS = ['--sandbox', 'read-only'];\r\n// What a read-only round takes of a tier: only what it can see, and only the model and its\r\n// reasoning. A profile (`ref`) is a file on the machine that may layer any setting �?a\r\n// feature, an MCP server, a command run after a turn �?and nothing here can read it; content\r\n// lines other than `model…` ones could do the same (`-c` takes any key). Whether `--sandbox`\r\n// wins over a profile's or a `-c` sandbox_mode could not be measured without a bypass on this\r\n// workstation, where every mode short of that falls back to read-only (docs/spike/readonly.md);\r\n// so the round is given nothing that would have to lose to it. The account is not a candidate\r\n// for read-only work until its tier is content of that kind, and the reason says so.\r\nconst READ_ONLY_TIER_KEY = /^model(_|$)/;\r\nfunction readOnlyTierProblem(tier: Tier): string | undefined {\r\n  if (tier.kind === 'ref') return `它是机器上的 profile�?{tier.value}），只读那一轮看不见里面写了什么。把这一档改成档位内容，只写模型和推理强度`;\r\n  const others = codexSettings(tier.text).map(({ key }) => key.trim()).filter((key) => !READ_ONLY_TIER_KEY.test(key.split('.')[0]!.trim()));\r\n  return others.length === 0 ? undefined : `档位内容里有模型和推理强度以外的设置�?{others.join('�?)}），只读那一轮不能带`;\r\n}\r\n\r\ntype Json = Record<string, unknown>;\r\nfunction object(value: unknown): Json | undefined {\r\n  return value !== null && typeof value === 'object' && !Array.isArray(value) ? value as Json : undefined;\r\n}\r\nfunction lineOf(text: string): Json | undefined {\r\n  try { return object(JSON.parse(text)); } catch { return undefined; }\r\n}\r\n\r\n// The strengths one model of the CLI's catalog takes, in its own order.\r\nfunction effortsOf(value: unknown): string[] {\r\n  if (!Array.isArray(value)) return [];\r\n  return value.flatMap((entry) => {\r\n    const effort = object(entry)?.effort;\r\n    return typeof effort === 'string' && effort !== '' ? [effort] : [];\r\n  });\r\n}\r\n\r\n// Recorded (tests/fixtures/codex/0.162.0/models.json): one JSON object whose `models` list\r\n// is the CLI's own catalog. `slug` is what a tier writes, `visibility` says whether the\r\n// CLI's picker hides it, and each model carries the strengths it takes �?which differ from\r\n// model to model, so they are read per model and never from one table.\r\nfunction parseModels(stdout: string): ModelInfo[] {\r\n  let answer: Json | undefined;\r\n  try {\r\n    answer = object(JSON.parse(stdout));\r\n  } catch {\r\n    return [];\r\n  }\r\n  const models = answer?.models;\r\n  if (!Array.isArray(models)) return [];\r\n  return models.flatMap((entry) => {\r\n    const model = object(entry);\r\n    const id = model?.slug;\r\n    if (!model || typeof id !== 'string' || id === '') return [];\r\n    const name = typeof model.display_name === 'string' && model.display_name !== '' ? model.display_name : undefined;\r\n    const efforts = effortsOf(model.supported_reasoning_levels);\r\n    const fallback = model.default_reasoning_level;\r\n    return [{\r\n      id,\r\n      ...(name === undefined ? {} : { name }),\r\n      ...(efforts.length === 0 ? {} : { efforts }),\r\n      ...(typeof fallback === 'string' && fallback !== '' ? { defaultEffort: fallback } : {}),\r\n      ...(model.visibility === 'hide' ? { hidden: true } : {}),\r\n    }];\r\n  });\r\n}\r\n\r\nfunction usageOf(value: unknown): Usage {\r\n  const usage = object(value);\r\n  const number = (key: string) => typeof usage?.[key] === 'number' ? usage[key] as number : 0;\r\n  return { inputTokens: number('input_tokens'), outputTokens: number('output_tokens'), cacheReadTokens: number('cached_input_tokens'), cacheWriteTokens: number('cache_write_input_tokens') };\r\n}\r\n// guess: authentication and quota wording has not been recorded yet.\r\nfunction classify(message: string): ReadingError['kind'] {\r\n  if (/\\b(429|402)\\b|quota|rate.limit|usage limit|credit balance/i.test(message)) return 'quota';\r\n  if (/\\b(401|403)\\b|unauthorized|forbidden|not logged in|not authenticated|invalid api key/i.test(message)) return 'auth';\r\n  return 'other';\r\n}\r\nfunction errorEvent(message: unknown): NormalizedEvent[] {\r\n  return typeof message === 'string' ? [{ kind: 'error', error: { kind: classify(message), message } }] : [];\r\n}\r\n// guess: tool item shapes and statuses have no recording in this fixture set.\r\nconst categories: Record<string, ToolCategory> = { command_execution: 'run', file_change: 'edit', web_search: 'search', mcp_tool_call: 'other' };\r\nfunction events(line: Json): NormalizedEvent[] {\r\n  if (line.type === 'error') return errorEvent(line.message);\r\n  if (line.type === 'turn.failed') return errorEvent(object(line.error)?.message);\r\n  if (line.type === 'turn.completed') return [{ kind: 'usage', usage: usageOf(line.usage) }, { kind: 'turn.end' }];\r\n  if (line.type !== 'item.started' && line.type !== 'item.completed') return [];\r\n  const item = object(line.item);\r\n  if (!item || typeof item.type !== 'string') return [];\r\n  if (line.type === 'item.completed' && item.type === 'error') return errorEvent(item.message);\r\n  if (line.type === 'item.completed' && item.type === 'agent_message' && typeof item.text === 'string') return [{ kind: 'text', text: item.text }];\r\n  if (line.type === 'item.completed' && item.type === 'reasoning' && typeof item.text === 'string') return [{ kind: 'thinking', text: item.text }];\r\n  if (!Object.hasOwn(categories, item.type) || typeof item.id !== 'string') return [];\r\n  if (line.type === 'item.started') return [{ kind: 'tool.start', id: item.id, category: categories[item.type], name: typeof item.command === 'string' ? item.command : item.type }];\r\n  const result: NormalizedEvent[] = [{ kind: 'tool.end', id: item.id, isError: item.status === 'failed' }];\r\n  const error = object(item.error);\r\n  if (error) result.push(...errorEvent(error.message));\r\n  return result;\r\n}\r\n\r\n// Codex takes its tier on the command line, one argument per line. What an argument\r\n// cannot carry is a NUL; what a value cannot carry is the newline that would have ended\r\n// its line. A `ref` is a profile name, and a name is not read as configuration: `--profile\r\n// <name>` only layers `$CODEX_HOME/<name>.config.toml`, so there is nothing to check in it.\r\nfunction checkTier(tier: Tier): string | undefined {\r\n  if (tier.kind === 'ref') return undefined;\r\n  const text = tier.text;\r\n  const why = checkTierText(text);\r\n  if (why) return why;\r\n  if (text.includes('\\0')) return '内容里有 tycho 传不过去的字�?;\r\n  for (const { at, line } of codexLines(text)) {\r\n    const equal = line.indexOf('=');\r\n    if (equal < 0) return `�?${at} 行没�?=，每行要写成 �?值`;\r\n    if (line.slice(0, equal).trim() === '') return `�?${at} 行的键是空的，每行要写成 �?值`;\r\n  }\r\n  const governing = codexSettings(text)\r\n    .map(({ key }) => key.trim())\r\n    .filter((key) => key.split('.').some((part) => PERMISSION_KEYS.includes(part.trim())));\r\n  return governing.length > 0 ? permissionKeyText(governing) : undefined;\r\n}\r\n\r\nexport const codexAdapter: Adapter = {\r\n  // Recorded (tests/fixtures/login-status): `codex --version` prints its version on stdout.\r\n  probe: { command: 'codex', version: ['--version'] },\r\n  // Recorded (tests/fixtures/login-status): `codex login status` answers on its exit code �?  // 0 signed in �?and prints its wording on stderr, where nothing reads it. The expired-token\r\n  // case is not recorded.\r\n  loginStatus: ['login', 'status'],\r\n  // No `resumable` and no `permissionModes`: this stage does not continue a Codex session,\r\n  // and `codex exec` is run without a sandbox rather than under one of Claude's modes �?  // except a read-only round, which runs in the read-only sandbox.\r\n  readOnly: {\r\n    layer: 'filesystem',\r\n    args: READ_ONLY_ARGS,\r\n    // Codex's own sandbox, read-only, running its own version command: nothing is written\r\n    // and no model is asked. Measured: it starts on this workstation (fixtures/readonly/probe)\r\n    // and fails with bwrap's own line on the cluster (fixtures/readonly/codex/codex-sandbox-linux.txt).\r\n    probe: { argv: ['codex', 'sandbox', '-c', 'sandbox_mode=read-only', '--', 'co